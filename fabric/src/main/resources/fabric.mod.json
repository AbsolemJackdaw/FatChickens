{
  "schemaVersion": 1,
  "id": "fatchicken",
  "version": "${version}",
  "custom": {
    "cardinal-components": [
      "fatchicken:fatties_data"
    ]
  },
  "name": "${mod_name}",
  "description": "${description}",
  "authors": [
    "${mod_author}"
  ],
  "contact": {
    "homepage": "https://www.curseforge.com/minecraft/mc-mods/fat-chicken",
    "sources": "https://github.com/AbsolemJackdaw/FatChickens"
  },
  "license": "${license}",
  "icon": "assets/modid/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "jackdaw.fatchicken.FatChicken"
    ],
    "client": [
      "jackdaw.fatchicken.FatChickenClient"
    ],
    "cardinal-components-entity": [
      "jackdaw.fatchicken.capability.Components"
    ]
  },
  "depends": {
    "fabricloader": ">=0.14",
    "fabric": "*",
    "minecraft": "${minecraft_version}",
    "java": ">=21"
  }
}
  